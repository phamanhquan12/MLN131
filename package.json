{
  "name": "mln131-do-min-tri-thuc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:bank": "tsx scripts/validate-question-bank.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "npm run build:e2e && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run validate:bank && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
